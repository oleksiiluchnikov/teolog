{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oleksiiluchnikov/teolog/schema/wide-event",
  "title": "teolog wide event",
  "description": "NDJSON wide event format shared across Rust, TypeScript, and Lua implementations",
  "type": "object",
  "required": ["ts", "lvl", "msg"],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "lvl": {
      "type": "string",
      "enum": ["trace", "debug", "info", "warn", "error"],
      "description": "Log level"
    },
    "msg": {
      "type": "string",
      "description": "Human-readable message"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Trace ID — groups all events for one top-level operation (32 hex chars / 16 bytes, OTEL-compatible)"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Unique span identifier (16 hex chars / 8 bytes, OTEL-compatible)"
    },
    "parent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "Parent span ID for trace correlation (16 hex chars / 8 bytes)"
    },
    "span": {
      "type": "string",
      "description": "Span or operation name"
    },
    "dur_ms": {
      "type": "number",
      "description": "Duration in milliseconds (set on span close)"
    },
    "project": {
      "type": "string",
      "description": "Project name (e.g. kolo, sayit, vault.nvim)"
    },
    "service": {
      "type": "string",
      "description": "Service/runtime name (e.g. tauri-backend, svelte-frontend, neovim)"
    },
    "module": {
      "type": "string",
      "description": "Module or component name"
    },
    "source": {
      "type": "string",
      "description": "Source file path where the log was emitted"
    },
    "lnum": {
      "type": "integer",
      "description": "Source line number"
    },
    "ctx": {
      "type": "object",
      "description": "Contextual key-value pairs accumulated during the span",
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "description": "Event-specific payload data",
      "additionalProperties": true
    },
    "err": {
      "type": "object",
      "description": "Error details (present only on error events)",
      "properties": {
        "message": { "type": "string" },
        "kind": { "type": "string" },
        "stack": { "type": "string" }
      }
    },
    "parent": {
      "type": "string",
      "description": "DEPRECATED: Use parent_id instead. Parent span name (not an ID, unreliable for correlation)",
      "deprecated": true
    }
  },
  "additionalProperties": true
}
